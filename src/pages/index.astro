---
import "../styles/global.css";

const services = [
  {
    title: "Carpintería",
    description: "Muebles a medida, repisas, puertas, closets y trabajos personalizados en madera.",
  },
  {
    title: "Albañilería",
    description: "Levantamiento de muros, resanes, aplanados, reparaciones y acabados.",
  },
  {
    title: "Reparaciones del hogar",
    description: "Mantenimiento general, corrección de daños y mejoras para espacios habitacionales.",
  },
  {
    title: "Remodelación",
    description: "Adecuación y transformación de espacios interiores y exteriores.",
  },
];

const projects = [
  {
    title: "Trabajo de carpintería",
    category: "Carpintería",
    image: "/evidencias-webp/carpinteria/despues/armario.webp",
    description: "Trabajo realizado en madera con acabado funcional y resistente.",
  },
  {
    title: "Reparación de muro",
    category: "Albañilería",
    image: "/evidencias-webp/albanileria/despues/resane.webp",
    description: "Corrección, resane y acabado de superficie para mejorar el espacio.",
  },
  {
    title: "Mantenimiento general",
    category: "Reparaciones",
    image: "/evidencias-webp/reparaciones/despues/tuberias.webp",
    description: "Solución práctica para reparación y mantenimiento del hogar.",
  },
];

const whatsappNumber = "12545007258";
const whatsappMessage = encodeURIComponent(
  "Hola, vi la página de C&R Contracting & Remodel y me interesa solicitar una cotización."
);

const heroImages = [
  {
    image: "/evidencias-webp/carpinteria/despues/puerta.webp",
    alt: "Trabajo de carpintería realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/vistageneral.webp",
    alt: "Trabajo de remodelación realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/lamparas.webp",
    alt: "Instalación y reparación realizada por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/cocina.webp",
    alt: "Trabajo en cocina realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/tocador.webp",
    alt: "Trabajo de remodelación realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/floorbathroom.webp",
    alt: "Trabajo de reparación de baño realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/cocina2.webp",
    alt: "Trabajo de reparación de baño realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/bathroom.webp",
    alt: "Trabajo de reparación de baño realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/reparaciones/despues/piso.webp",
    alt: "Trabajo de reparación de baño realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/albanileria/despues/muro.webp",
    alt: "Trabajo de albañilería realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/albanileria/despues/puertamuro.webp",
    alt: "Trabajo de muro y puerta realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/carpinteria/despues/piso.webp",
    alt: "Trabajo de acabado realizado por C&R Contracting & Remodel",
  },
    {
    image: "/evidencias-webp/carpinteria/despues/escalera.webp",
    alt: "Trabajo de acabado realizado por C&R Contracting & Remodel",
  },
  {
    image: "/evidencias-webp/carpinteria/despues/comedor1.webp",
    alt: "Trabajo de acabado realizado por C&R Contracting & Remodel",
  },
     {
    image: "/evidencias-webp/carpinteria/despues/comedor2.webp",
    alt: "Trabajo de acabado realizado por C&R Contracting & Remodel",
  },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>C&R Contracting & Remodel | Remodelación, carpintería y albañilería en Guadalajara</title>
    <meta
      name="description"
      content="C&R Contracting & Remodel ofrece servicios de remodelación, carpintería, albañilería, reparaciones y mantenimiento del hogar en Guadalajara y zona metropolitana."
    />
  </head>

  <body>
    <header class="fixed left-0 top-0 z-50 w-full border-b border-black/10 bg-[var(--color-bg)]/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="#" class="flex items-center gap-3">
          <img
            src="/brand/logo.webp"
            alt="C&R Contracting & Remodel"
            class="h-12 w-auto object-contain"
          />

          <div class="hidden sm:block">
            <p class="text-lg font-black leading-tight tracking-tight">
              C&R Contracting & Remodel
            </p>
            <p class="text-xs font-medium text-gray-500">
              Guadalajara, Jalisco
            </p>
          </div>
        </a>

        <nav class="hidden gap-6 text-sm font-medium text-gray-700 md:flex">
          <a href="#servicios" class="hover:text-[var(--color-accent)]">Servicios</a>
          <a href="#trabajos" class="hover:text-[var(--color-accent)]">Trabajos</a>
          <a href="#contacto" class="hover:text-[var(--color-accent)]">Contacto</a>
        </nav>

        <a
          href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
          class="rounded-full bg-[var(--color-accent)] px-4 py-2 text-sm font-bold text-white shadow-sm"
        >
          Cotizar
        </a>
      </div>
    </header>

    <main>
      <section class="relative overflow-hidden px-5 pb-20 pt-32">
        <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-center">
          <div>
            <p class="mb-4 inline-flex rounded-full bg-white px-4 py-2 text-sm font-bold text-[var(--color-wood)] shadow-sm">
              Guadalajara y zona metropolitana
            </p>

            <h1 class="text-4xl font-black leading-tight tracking-tight md:text-6xl">
              Soluciones reales para tu hogar
            </h1>

            <p class="mt-5 text-lg leading-8 text-gray-700">
              Carpintería, albañilería, reparaciones y mantenimiento general con atención directa,
              trabajo limpio y acabados duraderos.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
                class="rounded-xl bg-[var(--color-accent)] px-6 py-4 text-center font-bold text-white shadow-md"
              >
                Solicitar cotización
              </a>

              <a
                href="#trabajos"
                class="rounded-xl border border-black/10 bg-white px-6 py-4 text-center font-bold text-[var(--color-text)] shadow-sm"
              >
                Ver trabajos realizados
              </a>
            </div>
          </div>

          <div
            id="hero-carousel"
            data-images={JSON.stringify(heroImages)}
            class="relative rounded-3xl bg-white p-3 shadow-xl"
          >
            <button
              id="hero-gallery-open"
              type="button"
              class="group relative block w-full cursor-zoom-in overflow-hidden rounded-2xl"
              aria-label="Abrir galería de trabajos"
            >
              <img
                id="hero-carousel-image"
                src={heroImages[0].image}
                alt={heroImages[0].alt}
                class="h-[420px] w-full rounded-2xl bg-neutral-100 object-contain transition duration-300 group-hover:scale-[1.01]"
              />

              <span
                class="absolute bottom-5 right-5 rounded-full bg-black/65 px-4 py-2 text-sm font-bold text-white opacity-0 backdrop-blur-sm transition group-hover:opacity-100"
              >
                Ver galería
              </span>
            </button>

            <div class="absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 gap-2">
              {heroImages.map((item, index) => (
                <button
                  type="button"
                  data-carousel-dot={index}
                  aria-label={`Ver imagen ${index + 1}`}
                  class={`h-2.5 w-2.5 rounded-full ring-1 ring-black/10 transition ${
                    index === 0 ? "bg-[var(--color-accent)]" : "bg-white/80"
                  }`}
                />
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="servicios" class="px-5 py-20">
        <div class="mx-auto max-w-6xl">
          <div class="mb-10">
            <p class="text-sm font-black uppercase tracking-[0.2em] text-[var(--color-accent)]">
              Servicios
            </p>
            <h2 class="mt-3 text-3xl font-black md:text-4xl">
              Construimos, reparamos y mejoramos tu espacio
            </h2>
          </div>

          <div class="grid gap-5 md:grid-cols-4">
            {services.map((service) => (
              <article class="rounded-2xl border border-black/10 bg-white p-6 shadow-sm">
                <h3 class="text-xl font-black">{service.title}</h3>
                <p class="mt-3 leading-7 text-gray-700">{service.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="trabajos" class="bg-[var(--color-dark)] px-5 py-20 text-white">
        <div class="mx-auto max-w-6xl">
          <div class="mb-10">
            <p class="text-sm font-black uppercase tracking-[0.2em] text-orange-300">
              Evidencias
            </p>
            <h2 class="mt-3 text-3xl font-black md:text-4xl">
              Trabajos realizados
            </h2>
            <p class="mt-4 max-w-2xl leading-7 text-gray-300">
              Una muestra de trabajos de carpintería, albañilería, reparaciones y mantenimiento.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {projects.map((project) => (
              <article class="overflow-hidden rounded-2xl bg-white text-[var(--color-text)] shadow-lg">
                <button
                  type="button"
                  class="group block w-full cursor-pointer"
                  data-modal-image={project.image}
                  data-modal-title={project.title}
                  data-modal-category={project.category}
                >
                  <div class="flex h-72 items-center justify-center bg-neutral-100 p-3">
                    <img
                      src={project.image}
                      alt={project.title}
                      class="max-h-full w-full object-contain transition duration-300 group-hover:scale-[1.02]"
                    />
                  </div>
                </button>

                <div class="p-5">
                  <p class="text-sm font-bold text-[var(--color-accent)]">{project.category}</p>
                  <h3 class="mt-2 text-xl font-black">{project.title}</h3>
                  <p class="mt-3 leading-7 text-gray-700">{project.description}</p>

                  <button
                    type="button"
                    class="mt-4 text-sm font-black text-[var(--color-accent)]"
                    data-modal-image={project.image}
                    data-modal-title={project.title}
                    data-modal-category={project.category}
                  >
                    Ver imagen completa
                  </button>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="px-5 py-20">
        <div class="mx-auto grid max-w-6xl gap-8 rounded-3xl bg-white p-8 shadow-sm md:grid-cols-3">
          <div>
            <h3 class="text-xl font-black">Atención directa</h3>
            <p class="mt-3 leading-7 text-gray-700">
              Comunicación clara para revisar el tipo de trabajo y acordar detalles.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-black">Trabajo limpio</h3>
            <p class="mt-3 leading-7 text-gray-700">
              Cuidado del espacio durante el proceso de reparación o construcción.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-black">Acabados duraderos</h3>
            <p class="mt-3 leading-7 text-gray-700">
              Soluciones pensadas para que el trabajo sea funcional y resistente.
            </p>
          </div>
        </div>
      </section>

      <section id="contacto" class="px-5 py-20">
        <div class="mx-auto max-w-3xl rounded-3xl bg-[var(--color-text)] p-8 text-center text-white shadow-xl">
          <h2 class="text-3xl font-black md:text-4xl">
            ¿Necesitas una reparación o cotización?
          </h2>

          <p class="mt-4 leading-8 text-gray-200">
            Envía un mensaje por WhatsApp con una descripción del trabajo y, si es posible,
            agrega fotos del espacio para una mejor orientación.
          </p>

          <a
            href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
            class="mt-8 inline-flex rounded-xl bg-[var(--color-accent)] px-8 py-4 font-black text-white shadow-md"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </section>
    </main>

    <a
      href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
      class="fixed bottom-5 right-5 z-50 rounded-full bg-green-600 px-5 py-4 text-sm font-black text-white shadow-lg"
    >
      WhatsApp
    </a>

    <div
      id="image-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
    >
      <div class="relative w-full max-w-5xl">
        <button
          id="modal-close"
          type="button"
          class="absolute -top-12 right-0 rounded-full bg-white px-4 py-2 text-sm font-black text-[var(--color-text)] shadow-lg"
        >
          Cerrar
        </button>

        <div class="overflow-hidden rounded-3xl bg-white p-4 shadow-2xl">
          <div class="mb-4">
            <p
              id="modal-category"
              class="text-sm font-black uppercase tracking-[0.2em] text-[var(--color-accent)]"
            ></p>
            <h3 id="modal-title" class="mt-1 text-2xl font-black text-[var(--color-text)]"></h3>
          </div>

          <img
            id="modal-image"
            src=""
            alt=""
            class="max-h-[75vh] w-full rounded-2xl bg-neutral-100 object-contain"
          />
        </div>
      </div>
    </div>

    <div
      id="hero-gallery-modal"
      class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/90 p-3 backdrop-blur-md sm:p-6"
      aria-hidden="true"
    >
      <div class="relative flex max-h-[94vh] w-full max-w-6xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-black/10 px-5 py-4">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-[var(--color-accent)]">
              C&R Contracting & Remodel
            </p>
            <h2 class="mt-1 text-xl font-black text-[var(--color-text)] sm:text-2xl">
              Galería de trabajos
            </h2>
          </div>

          <button
            id="hero-gallery-close"
            type="button"
            class="rounded-full border border-black/10 bg-neutral-100 px-4 py-2 text-sm font-black text-[var(--color-text)] transition hover:bg-neutral-200"
          >
            Cerrar
          </button>
        </div>

        <div class="min-h-0 overflow-y-auto p-4 sm:p-6">
          <div class="relative flex min-h-[300px] items-center justify-center rounded-2xl bg-neutral-100 sm:min-h-[480px]">
            <button
              id="hero-gallery-prev"
              type="button"
              class="absolute left-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/65 text-2xl font-bold text-white shadow-lg backdrop-blur transition hover:bg-black/80"
              aria-label="Imagen anterior"
            >
              ‹
            </button>

            <img
              id="hero-gallery-image"
              src={heroImages[0].image}
              alt={heroImages[0].alt}
              class="max-h-[62vh] w-full rounded-2xl object-contain"
            />

            <button
              id="hero-gallery-next"
              type="button"
              class="absolute right-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/65 text-2xl font-bold text-white shadow-lg backdrop-blur transition hover:bg-black/80"
              aria-label="Imagen siguiente"
            >
              ›
            </button>

            <span
              id="hero-gallery-counter"
              class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-black/65 px-3 py-1 text-xs font-bold text-white backdrop-blur"
            >
              1 / {heroImages.length}
            </span>
          </div>

          <div class="mt-4">
            <p class="mb-3 text-sm font-bold text-gray-600">Selecciona una imagen</p>
            <div class="flex gap-3 overflow-x-auto pb-2">
              {heroImages.map((item, index) => (
                <button
                  type="button"
                  data-gallery-thumbnail={index}
                  class={`shrink-0 overflow-hidden rounded-xl border-2 bg-neutral-100 transition ${
                    index === 0
                      ? "border-[var(--color-accent)]"
                      : "border-transparent hover:border-black/20"
                  }`}
                  aria-label={`Abrir imagen ${index + 1}`}
                >
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="h-20 w-28 object-cover sm:h-24 sm:w-36"
                    loading="lazy"
                  />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      const heroCarousel = document.querySelector("#hero-carousel");
      const heroImage = document.querySelector("#hero-carousel-image");
      const dots = document.querySelectorAll("[data-carousel-dot]");
      const heroGalleryOpen = document.querySelector("#hero-gallery-open");
      const heroGalleryModal = document.querySelector("#hero-gallery-modal");
      const heroGalleryClose = document.querySelector("#hero-gallery-close");
      const heroGalleryImage = document.querySelector("#hero-gallery-image");
      const heroGalleryCounter = document.querySelector("#hero-gallery-counter");
      const heroGalleryPrev = document.querySelector("#hero-gallery-prev");
      const heroGalleryNext = document.querySelector("#hero-gallery-next");
      const galleryThumbnails = document.querySelectorAll("[data-gallery-thumbnail]");

      let heroImagesData = [];
      let currentImage = 0;
      let carouselInterval;

      const updateCarouselDots = () => {
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle("bg-[var(--color-accent)]", dotIndex === currentImage);
          dot.classList.toggle("bg-white/80", dotIndex !== currentImage);
        });
      };

      const showHeroImage = (index) => {
        if (!heroImage || !heroImagesData.length) return;

        currentImage = (index + heroImagesData.length) % heroImagesData.length;
        heroImage.classList.add("opacity-0");

        window.setTimeout(() => {
          heroImage.setAttribute("src", heroImagesData[currentImage].image);
          heroImage.setAttribute("alt", heroImagesData[currentImage].alt);
          updateCarouselDots();
          heroImage.classList.remove("opacity-0");
        }, 220);
      };

      const stopCarousel = () => {
        if (carouselInterval) {
          window.clearInterval(carouselInterval);
        }
      };

      const startCarousel = () => {
        stopCarousel();
        if (heroImagesData.length < 2) return;

        carouselInterval = window.setInterval(() => {
          showHeroImage(currentImage + 1);
        }, 3500);
      };

      if (heroCarousel && heroImage) {
        heroImagesData = JSON.parse(heroCarousel.getAttribute("data-images") || "[]");
        startCarousel();

        dots.forEach((dot) => {
          dot.addEventListener("click", () => {
            const index = Number(dot.getAttribute("data-carousel-dot"));
            showHeroImage(index);
            startCarousel();
          });
        });
      }

      const showGalleryImage = (index) => {
        if (!heroImagesData.length || !heroGalleryImage) return;

        currentImage = (index + heroImagesData.length) % heroImagesData.length;
        const item = heroImagesData[currentImage];

        heroGalleryImage.setAttribute("src", item.image);
        heroGalleryImage.setAttribute("alt", item.alt);

        if (heroGalleryCounter) {
          heroGalleryCounter.textContent = `${currentImage + 1} / ${heroImagesData.length}`;
        }

        galleryThumbnails.forEach((thumbnail, thumbnailIndex) => {
          thumbnail.classList.toggle("border-[var(--color-accent)]", thumbnailIndex === currentImage);
          thumbnail.classList.toggle("border-transparent", thumbnailIndex !== currentImage);
        });

        if (heroImage) {
          heroImage.setAttribute("src", item.image);
          heroImage.setAttribute("alt", item.alt);
          updateCarouselDots();
        }
      };

      const openHeroGallery = () => {
        if (!heroGalleryModal) return;

        stopCarousel();
        showGalleryImage(currentImage);
        heroGalleryModal.classList.remove("hidden");
        heroGalleryModal.classList.add("flex");
        heroGalleryModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const closeHeroGallery = () => {
        if (!heroGalleryModal) return;

        heroGalleryModal.classList.add("hidden");
        heroGalleryModal.classList.remove("flex");
        heroGalleryModal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        startCarousel();
      };

      heroGalleryOpen?.addEventListener("click", openHeroGallery);
      heroGalleryClose?.addEventListener("click", closeHeroGallery);
      heroGalleryPrev?.addEventListener("click", () => showGalleryImage(currentImage - 1));
      heroGalleryNext?.addEventListener("click", () => showGalleryImage(currentImage + 1));

      galleryThumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener("click", () => {
          const index = Number(thumbnail.getAttribute("data-gallery-thumbnail"));
          showGalleryImage(index);
        });
      });

      heroGalleryModal?.addEventListener("click", (event) => {
        if (event.target === heroGalleryModal) {
          closeHeroGallery();
        }
      });

      const modal = document.querySelector("#image-modal");
      const modalImage = document.querySelector("#modal-image");
      const modalTitle = document.querySelector("#modal-title");
      const modalCategory = document.querySelector("#modal-category");
      const modalClose = document.querySelector("#modal-close");
      const modalButtons = document.querySelectorAll("[data-modal-image]");

      const openModal = (button) => {
        if (!modal || !modalImage || !modalTitle || !modalCategory) return;

        const image = button.getAttribute("data-modal-image") || "";
        const title = button.getAttribute("data-modal-title") || "Trabajo realizado";
        const category = button.getAttribute("data-modal-category") || "";

        modalImage.setAttribute("src", image);
        modalImage.setAttribute("alt", title);
        modalTitle.textContent = title;
        modalCategory.textContent = category;

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        if (!modal || !modalImage) return;

        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modalImage.setAttribute("src", "");
        document.body.style.overflow = "";
      };

      modalButtons.forEach((button) => {
        button.addEventListener("click", () => openModal(button));
      });

      modalClose?.addEventListener("click", closeModal);

      modal?.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });

      document.addEventListener("keydown", (event) => {
        const galleryIsOpen = heroGalleryModal && !heroGalleryModal.classList.contains("hidden");
        const imageModalIsOpen = modal && !modal.classList.contains("hidden");

        if (galleryIsOpen) {
          if (event.key === "Escape") closeHeroGallery();
          if (event.key === "ArrowLeft") showGalleryImage(currentImage - 1);
          if (event.key === "ArrowRight") showGalleryImage(currentImage + 1);
          return;
        }

        if (event.key === "Escape" && imageModalIsOpen) {
          closeModal();
        }
      });
